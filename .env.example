# ── Roblox Bot ────────────────────────────────────────────────────────────────
# Cookie .ROBLOSECURITY du compte bot (à récupérer dans les DevTools de roblox.com)
ROBLOX_COOKIE=ton_cookie_ici

# Code du serveur privé MM2 (le code dans l'URL du lien de partage)
# Ex: roblox.com/games/.../play?privateServerLinkCode=ABCDEF → PRIVATE_SERVER_CODE=ABCDEF
PRIVATE_SERVER_CODE=ton_code_serveur_prive

# ID du jeu MM2 (Place ID)
GAME_ID=142823291
PLACE_ID=142823291

# ── API Site (Vercel) ─────────────────────────────────────────────────────────
# URL complète de ton endpoint inventory
API_URL=https://ton-site.vercel.app/api/inventory

# Secret partagé entre le bot Node.js et les Serverless Functions Vercel
BOT_SECRET=choisis_un_secret_fort_ici

# ── Bridge (BotBridge.lua ↔ bot Node.js) ──────────────────────────────────────
# Secret partagé entre BotBridge.lua et le serveur Express du bot
BRIDGE_SECRET=autre_secret_fort_ici

# Port local du serveur bridge (doit être exposé publiquement via ngrok ou Cloudflare Tunnel)
# Commande ngrok : ngrok http 3001
BRIDGE_PORT=3001

# ── Timing ────────────────────────────────────────────────────────────────────
# Intervalle de vérification des trades entrants (millisecondes)
SCAN_INTERVAL_MS=8000

# ── OAuth (pour Vercel) ────────────────────────────────────────────────────────
BASE_URL=https://ton-site.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=
