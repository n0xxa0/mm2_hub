# ── Bot MM2 Hub — Variables d'environnement ──────────────────────────────────
# Copie ce fichier en .env dans le dossier /bot/

# Cookie Roblox du compte bot (.ROBLOSECURITY)
# Va sur roblox.com → F12 → Application → Cookies → copie la valeur de .ROBLOSECURITY
ROBLOX_COOKIE=_|WARNING:-DO-NOT-SHARE-THIS.--Sharing-this-will-allow-someone-to-log-into-your-account...|xxxxxx

# ID du jeu Murder Mystery 2
GAME_ID=142823291

# Code du serveur privé (depuis le lien d'invitation du serveur privé MM2)
# Ex: si le lien est roblox.com/games/142823291?privateServerLinkCode=XXXXX
PRIVATE_SERVER_CODE=

# URL de l'API Vercel
API_URL=https://TON-SITE.vercel.app/api/inventory

# Secret partagé entre le bot et l'API Vercel (choisis n'importe quelle chaîne aléatoire)
BOT_SECRET=change_moi_par_un_vrai_secret_random

# Intervalle de vérification des trades (millisecondes)
SCAN_INTERVAL_MS=10000
