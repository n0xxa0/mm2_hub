# ══════════════════════════════════
# MM2 Hub — Variables d'environnement
# Copiez ce fichier en .env.local pour le développement
# Sur Vercel : ajoutez ces variables dans Settings > Environment Variables
# ══════════════════════════════════

# URL de base du site (sans slash final)
# Ex: https://mm2hub.vercel.app  ou  http://localhost:3000
BASE_URL=https://TON_PROJET.vercel.app

# ── Google OAuth ──────────────────
# https://console.cloud.google.com/apis/credentials
# Crée un "OAuth 2.0 Client ID" de type "Web application"
# Redirect URI autorisé : https://TON_PROJET.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Discord OAuth ─────────────────
# https://discord.com/developers/applications
# Crée une app > OAuth2 > Redirects : https://TON_PROJET.vercel.app/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Note : Roblox n'utilise pas de clé secrète.
# L'API publique Roblox est appelée directement depuis /api/auth/roblox
